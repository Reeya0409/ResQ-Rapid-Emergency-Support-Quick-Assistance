# --- App ---
APP_NAME=ResQ API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# --- CORS: comma-separated in .env is NOT supported by pydantic-settings' List parsing here,
# use a JSON array string instead, e.g. ["http://localhost:5500","http://127.0.0.1:5500"]
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:3000"]

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=resq

# --- JWT ---
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER_ME=30

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# --- File uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- Weather providers (optional — mock data used until set) ---
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=

# --- Maps ---
GOOGLE_MAPS_API_KEY=

# --- AI providers (optional — mock chatbot used until set) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Email (optional — forgot-password logs instead of sending until set) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- SMS (optional) ---
SMS_PROVIDER_API_KEY=

# --- Google OAuth (optional — /auth/google returns 501 until set) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
